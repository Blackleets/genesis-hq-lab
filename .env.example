# --- Mean Reversion Scalper (MR Scalper) ---
# Strategy parameters for the mean reversion scalper
MR_TP_ATR_MULT=2.0
MR_SL_ATR_MULT=1.0
MR_MIN_CONF=0.60
MR_MAX_CAPITAL=100
MR_MAX_CONCURRENT=3
MR_MIN_ATR_PCT=0.003
MR_MAX_ATR_PCT=0.015
MR_RSI_OB=70
MR_RSI_OS=30
MR_BB_PERIOD=20
MR_BB_STD=2.0
MR_ADX_PERIOD=14
MR_ADX_THRESHOLD=25
MR_RANGE_PERIOD=20
MR_VOL_MA=20
MR_VOL_MULT=1.5
MR_AVOID_LOW_LIQ=true

# --- Genesis Economic Scoreboard ---
# Explicit monthly operating cost in USD. Leave empty until audited/configured.
# The UI will refuse to claim "pays for itself" without this cost basis.
VITE_GENESIS_MONTHLY_COST_USD=

# --- MEV / DEX Arbitrage Radar (SHADOW only) ---
# Preferred read-only Ethereum RPC endpoint. Never commit a real provider key here.
GENESIS_MEV_RPC_URL=
# Optional comma-separated additional read-only providers, tried before public fallbacks.
GENESIS_MEV_RPC_URLS=
# Public read-only fallback (PublicNode / Ankr). Set false to require configured providers only.
GENESIS_MEV_PUBLIC_RPC_FALLBACK=true
# After a provider passes chainId but fails a deeper scan, skip it for this many cycles.
GENESIS_MEV_RPC_COOLDOWN_CYCLES=3
# Shadow route notional used for quote comparisons.
GENESIS_MEV_NOTIONAL_USD=1000
# Conservative whole-route gas budget until an exact executor simulation succeeds.
GENESIS_MEV_ROUTE_GAS_UNITS=450000
# Extra adverse-slippage reserve on top of same-block DEX quotes.
GENESIS_MEV_SLIPPAGE_RESERVE_BPS=10
# Set only when explicitly modeling flash-loan funding; 0 = prefunded shadow model.
GENESIS_MEV_FLASH_LOAN_BPS=0
# Read-only observation cadence. This does not enable execution.
GENESIS_MEV_SCAN_INTERVAL_MS=12000

# --- Arbitrage atomic simulation (still SHADOW, still no signing) ---
# Optional deployed simulation-compatible executor. With this empty, atomicity
# remains unproven and every route stays filtered by the atomic simulation gate.
GENESIS_MEV_EXECUTOR_ADDRESS=
# Optional sender identity for eth_call/estimateGas only. No private key is used.
GENESIS_MEV_SIMULATION_FROM=
# Hard ceiling for a simulated route. Routes above it fail closed.
GENESIS_MEV_MAX_SIM_GAS_UNITS=1200000

# --- Same-block liquidity proof ---
# Re-quote the exact route at a larger notional on the same block.
GENESIS_MEV_LIQUIDITY_PROBE_MULTIPLIER=2
# Full confidence when size-stress degrades route efficiency by no more than this.
GENESIS_MEV_LIQUIDITY_FULL_BPS=5
# Zero confidence when size-stress degrades route efficiency by this much or more.
GENESIS_MEV_LIQUIDITY_ZERO_BPS=50

# --- Solana arbitrage execution pipeline ---
# SHADOW is the safe default. PAPER requires a configured transaction builder,
# RPC simulator and paper capture adapter. LIVE is intentionally not accepted.
GENESIS_SOLANA_EXECUTION_MODE=SHADOW
JUPITER_API_KEY=
GENESIS_SOLANA_RPC_URL=
# Public address only; never place a private key or seed phrase here.
# Used to request Jupiter instructions and identify route-local writable accounts.
GENESIS_SOLANA_OBSERVER_PUBLIC_KEY=
# Optional comma-separated read-only RPC endpoints. Keep these on free tiers.
GENESIS_SOLANA_FREE_RPC_URLS=
GENESIS_SOLANA_RPC_BENCHMARK_SAMPLES=5
GENESIS_SOLANA_ARB_NOTIONAL_USDC=25
GENESIS_SOLANA_ARB_NOTIONALS_USDC=10,25,50,100,250,500
GENESIS_SOLANA_ARB_SLIPPAGE_BPS=10
GENESIS_SOLANA_LATENCY_DEGRADATION_BPS=5
GENESIS_SOLANA_ADVERSE_SELECTION_BPS=5
GENESIS_SOLANA_FAILURE_PROBABILITY_RESERVE=0.10
GENESIS_SOLANA_MIN_NET_EDGE_BPS=8
GENESIS_SOLANA_MAX_TRADE_USD=25
GENESIS_SOLANA_MAX_DAILY_LOSS_USD=2
GENESIS_SOLANA_MAX_SLIPPAGE_BPS=40
GENESIS_SOLANA_MAX_PRIORITY_FEE_USD=0.05
GENESIS_SOLANA_MAX_JITO_TIP_USD=0.05
GENESIS_SOLANA_MAX_QUOTE_AGE_MS=1500
GENESIS_SOLANA_MAX_SLOT_DRIFT=4
GENESIS_SOLANA_MAX_CONSECUTIVE_FAILURES=3
GENESIS_SOLANA_DAILY_EXECUTION_LIMIT=50
GENESIS_SOLANA_EMERGENCY_STOP=false

# --- Telegram notification gateway (backend only) ---
# Use a long random value. Rotating it invalidates encrypted stored bot tokens.
TELEGRAM_CONFIG_ENCRYPTION_KEY=
# Supabase's server-only secret key is preferred; legacy service role keys remain compatible.
SUPABASE_SECRET_KEY=
# Shared only by the observer workflow and the backend dispatch endpoint.
GENESIS_NOTIFICATION_DISPATCH_SECRET=
# Canonical HTTPS deployment origin, e.g. https://genesis.example.com.
GENESIS_NOTIFY_URL=
