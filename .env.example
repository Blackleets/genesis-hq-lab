# Genesis HQ Lab — environment template.
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. NEVER commit a real `.env`.

# --- Frontend (Vercel) — URL del backend Render ---
# Ejemplo: https://genesis-hq-backend.onrender.com
VITE_API_BASE=

# --- Anthropic (AutoView AI planning + trading debates) ---
ANTHROPIC_API_KEY=

# --- Backend ---
HOST=127.0.0.1
PORT=8787

# --- Kalshi (optional; without key scanner returns empty) ---
KALSHI_API_KEY=

# --- Crypto scalping engine ---
# Assets to trade (SYMBOL:PAIR comma-separated). Leave blank for BTC/ETH/SOL/BNB.
# Adding a coin later is a one-line change here, then validate with `npm run backtest`.
# Example: CRYPTO_ASSETS=BTC:BTCUSDT,ETH:ETHUSDT,XRP:XRPUSDT,DOGE:DOGEUSDT
CRYPTO_ASSETS=
# Binance taker fee per side (default 0.001 = 0.1%). Applied to paper PnL for realism.
CRYPTO_FEE_PCT=0.001
# Circuit breakers (risk controls — NOT tuned by the optimizer):
CRYPTO_COOLDOWN_MIN=15        # pause an asset this many minutes after a loss
CRYPTO_DAILY_LOSS_CAP=300     # halt new crypto entries once daily realized loss hits this ($)

# --- Crypto optimizer (24/7 training) ---
OPTIMIZER_INTERVAL_MIN=45     # minutes between optimization passes (continuous mode)
OPTIMIZER_MIN_TRADES=30       # minimum aggregate trades for a param set to qualify
# Override where strategy params are stored (defaults to data/strategy/crypto_params.json)
# CRYPTO_PARAMS_PATH=

# --- Local dev ---
VITE_PORT=5173
VITE_TITLE="Genesis HQ Lab"

# --- Optional fixtures source ---
# If you want the lab to read JSON fixtures from a local path instead of the
# bundled src/fixtures, point this at a folder. Leave blank to use bundled.
VITE_FIXTURES_PATH=

# --- Optional read-only mirror of the main Genesis backend ---
# If you want to point the lab at a READ-ONLY backend during prototyping,
# set this to the base URL. Leave blank to stay fully local.
# IMPORTANT: this is read-only. Never POST/PATCH from this lab.
VITE_GENESIS_READONLY_BASE=
