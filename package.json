{
  "name": "genesis-hq-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "concurrently -n server,agent,optimizer,web -c green,magenta,yellow,cyan -k \"npm run server\" \"npm run agent\" \"npm run optimizer\" \"npm run dev\"",
    "start:ui": "concurrently -n server,web -c green,cyan -k \"npm run server\" \"npm run dev\"",
    "db:restore": "node --env-file-if-exists=.env server/persistence/restore.mjs",
    "start:render": "npm run db:restore ; concurrently -n server,agent,optimizer -c green,magenta,yellow --restart-tries -1 --restart-after 5000 \"npm run server\" \"npm run agent\" \"npm run optimizer\"",
    "start:render:lean": "concurrently -n server,agent -c green,magenta --restart-tries -1 --restart-after 5000 \"npm run server\" \"npm run agent\"",
    "mcp": "node server/mcpServer.mjs",
    "test": "node --test --test-concurrency=1 \"server/tests/**/*.test.mjs\"",
    "backtest": "node --env-file-if-exists=.env server/crypto/backtest/runBacktest.mjs",
    "optimizer": "node --env-file-if-exists=.env server/crypto/runOptimizer.mjs",
    "agent": "node --env-file-if-exists=.env server/agentRunner.mjs",
    "agent:once": "node --env-file-if-exists=.env server/agentRunner.mjs --once",
    "agent:verbose": "node --env-file-if-exists=.env server/agentRunner.mjs --verbose",
    "agent:futures": "node --env-file-if-exists=.env scripts/runFuturesOnlyAgent.mjs",
    "agent:futures:once": "node --env-file-if-exists=.env scripts/runFuturesOnlyAgent.mjs --once",
    "crypto:phase1": "node scripts/cryptoPhase1Check.mjs",
    "crypto:lab": "node scripts/runCryptoStrategyLab.mjs",
    "crypto:trend-search": "node --env-file-if-exists=.env server/crypto/backtest/trendSearch.mjs",
    "futures:status": "node --env-file-if-exists=.env scripts/futuresDesk.mjs",
    "futures:once": "node --env-file-if-exists=.env scripts/futuresDesk.mjs --run",
    "futures:reset": "node --env-file-if-exists=.env scripts/resetFuturesPnlBaseline.mjs",
    "skills:sync": "node server/skills/skillRegistry.mjs",
    "skills:export": "node server/skills/exportTrajectories.mjs",
    "skills:validate": "node server/skills/validateSkill.mjs",
    "skillopt": "node --env-file-if-exists=.env server/skills/runSkillOpt.mjs",
    "skillopt:benchmark": "node --env-file-if-exists=.env server/skills/benchmarkReplay.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.100.14",
    "better-sqlite3": "^12.10.0",
    "framer-motion": "^12.40.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.16.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "viem": "^2.51.3",
    "wagmi": "^3.6.16",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
